<?php
/**
 * @var \Fullspec\AnswerEng\Block\Adminhtml\Status\Panel $block
 * @var \Magento\Framework\Escaper $escaper
 */
use Fullspec\AnswerEng\Model\Admin\PanelLabels;

$storeId = $block->getStoreId();
$panel = $block->getPanel();
$pct = static fn (?float $x): string => $x === null ? '–' : number_format($x * 100, 1) . '%';
$pill = static fn (array $l): string => '<span class="ae-pill ae-pill--' . $escaper->escapeHtmlAttr($l['tone']) . '">'
    . $escaper->escapeHtml($l['label']) . '</span>';
$logShown = 5;
?>
<div class="answereng-panel" data-mage-init='{"Fullspec_AnswerEng/js/panel-actions": {}}'>
    <div class="ae-head">
        <svg class="ae-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <rect width="32" height="32" rx="8"/><path d="M8 22V10m16 12V10M8 16h16"/><circle cx="19" cy="16" r="4"/>
        </svg>
        <div class="ae-head-text">
            <span class="ae-title"><?= $escaper->escapeHtml(__('AnswerEng')) ?></span>
            <?php if ($storeId > 0 && (string) ($panel['storeKey'] ?? '') !== ''): ?>
                <span class="ae-subtitle"><?= $escaper->escapeHtml(__('Store key')) ?>
                    <code><?= $escaper->escapeHtml($panel['storeKey']) ?></code></span>
            <?php endif; ?>
        </div>
        <div class="ae-head-end">
            <?php if ($storeId > 0): ?>
                <?php $viewState = PanelLabels::state(
                    $panel['state'],
                    $panel['reason'],
                    $panel['lastSyncAt'],
                    $panel['summary']->state
                ); ?>
                <?= /* @noEscape */ $pill($viewState) ?>
            <?php endif; ?>
            <a class="ae-settings-link" href="<?= $escaper->escapeUrl($block->getSettingsUrl()) ?>">
                <?= $escaper->escapeHtml(__('Settings')) ?></a>
        </div>
    </div>

<?php if ($storeId <= 0): ?>
    <p class="ae-intro"><?= $escaper->escapeHtml(__('Choose a store view above, or open one below, to see its AI '
        . 'visibility, test the connection or manage its AnswerEng store.')) ?></p>
    <?php if ($panel === []): ?>
        <p class="ae-empty"><?= $escaper->escapeHtml(__('No store view is enabled for AnswerEng yet. In Settings, '
            . 'choose a store view, set "Enabled for AnswerEng" to Yes, and save.')) ?>
            <a href="<?= $escaper->escapeUrl($block->getSettingsUrl()) ?>">
                <?= $escaper->escapeHtml(__('Open settings')) ?></a></p>
    <?php else: ?>
        <table class="data-grid ae-grid">
            <thead><tr>
                <th><?= $escaper->escapeHtml(__('Store view')) ?></th>
                <th><?= $escaper->escapeHtml(__('Store key')) ?></th>
                <th><?= $escaper->escapeHtml(__('Status')) ?></th>
                <th><?= $escaper->escapeHtml(__('Last sync (UTC)')) ?></th>
                <th class="ae-num"><?= $escaper->escapeHtml(__('Products')) ?></th>
                <th><span class="ae-visually-hidden"><?= $escaper->escapeHtml(__('Action')) ?></span></th>
            </tr></thead>
            <tbody>
            <?php foreach ($panel as $row): ?>
                <tr>
                    <?php $viewUrl = $block->getUrl('answereng/status/index', ['store' => $row['storeId']]); ?>
                    <td><a href="<?= $escaper->escapeUrl($viewUrl) ?>">
                        <?= $escaper->escapeHtml($row['name']) ?></a></td>
                    <td><code><?= $escaper->escapeHtml($row['storeKey']) ?></code></td>
                    <?php $rowState = PanelLabels::state($row['state'], $row['reason'], $row['lastSyncAt']); ?>
                    <td><?= /* @noEscape */ $pill($rowState) ?>
                        <?php if ($row['message'] !== null): ?>
                            <span class="ae-row-note"><?= $escaper->escapeHtml($row['message']) ?></span>
                        <?php endif; ?></td>
                    <td><?= $escaper->escapeHtml(PanelLabels::when($row['lastSyncAt'])) ?></td>
                    <td class="ae-num"><?= $escaper->escapeHtml((string) ($row['productCount'] ?? '–')) ?></td>
                    <td class="ae-cell-action">
                        <?php if ($row['canSync']): ?>
                            <?php $rowFields = json_encode(['store' => $row['storeId']]); ?>
                            <button type="button" class="action-secondary"
                                    data-answereng-action="<?= $escaper->escapeHtmlAttr($row['syncUrl']) ?>"
                                    data-fields='<?= $escaper->escapeHtmlAttr($rowFields) ?>'>
                                <?= $escaper->escapeHtml(__('Sync now')) ?></button>
                        <?php endif; ?>
                    </td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
<?php else: ?>
    <?php $summary = $panel['summary']; ?>
    <?php if ($panel['pendingDeletion'] !== null): ?>
        <?php $pd = $panel['pendingDeletion']; ?>
        <div class="message message-warning ae-message">
            <?php $pdText = $pd['purgeAfter'] !== null
                ? __(
                    'AnswerEng store "%1" is scheduled for deletion on %2 UTC.',
                    $pd['storeKey'],
                    PanelLabels::when($pd['purgeAfter'])
                )
                : __('AnswerEng store "%1" is scheduled for deletion.', $pd['storeKey']); ?>
            <span><?= $escaper->escapeHtml($pdText) ?></span>
            <?php if ($panel['canDelete']): ?>
                <?php $cancelFields = json_encode(['store' => $storeId, 'identity_id' => $pd['id']]); ?>
                <button type="button" class="action-secondary"
                        data-answereng-action="<?= $escaper->escapeHtmlAttr($panel['urls']['cancel']) ?>"
                        data-fields='<?= $escaper->escapeHtmlAttr($cancelFields) ?>'>
                    <?= $escaper->escapeHtml(__('Cancel deletion')) ?></button>
            <?php endif; ?>
        </div>
    <?php endif; ?>

    <dl class="ae-facts">
        <div><dt><?= $escaper->escapeHtml(__('Last sync')) ?></dt>
            <dd><?= $escaper->escapeHtml(PanelLabels::when($panel['lastSyncAt'])) ?>
                <?php if ($panel['lastSyncAt'] !== null): ?><span class="ae-unit">UTC</span><?php endif; ?></dd></div>
        <div><dt><?= $escaper->escapeHtml(__('Products sent')) ?></dt>
            <dd><?= $escaper->escapeHtml((string) ($panel['productCount'] ?? '–')) ?></dd></div>
    </dl>
    <?php if ($panel['message'] !== null): ?>
        <p class="ae-state-message answereng-state-message"><?= $escaper->escapeHtml($panel['message']) ?></p>
    <?php endif; ?>

    <section class="ae-visibility" aria-labelledby="ae-visibility-<?= (int) $storeId ?>">
        <h3 class="ae-section-title" id="ae-visibility-<?= (int) $storeId ?>">
            <?= $escaper->escapeHtml(__('AI visibility')) ?></h3>
        <?php if (in_array($summary->state, ['fresh', 'stale'], true) && $summary->rate !== null): ?>
            <p class="ae-figure"><?= $escaper->escapeHtml($pct($summary->rate)) ?>
                <span class="ae-range"><?= $escaper->escapeHtml(__(
                    'likely %1–%2',
                    $pct($summary->low),
                    $pct($summary->high)
                )) ?></span></p>
            <p class="ae-meta">
                <?= $escaper->escapeHtml(__('Share of AI answers that recommend your store.')) ?>
                <?php if ($summary->runStartedAt !== null): ?>
                    <?= $escaper->escapeHtml(__('Latest run %1 UTC.', PanelLabels::when($summary->runStartedAt))) ?>
                <?php endif; ?>
            </p>
            <?php if ($summary->state === 'stale'): ?>
                <?php $fetchedAt = $summary->fetchedAt?->format('Y-m-d H:i'); ?>
                <p class="ae-meta ae-meta--warn"><?= $escaper->escapeHtml(__(
                    'Could not refresh from AnswerEng. Showing results fetched %1 UTC.',
                    PanelLabels::when($fetchedAt)
                )) ?></p>
            <?php endif; ?>
        <?php elseif ($summary->state === 'stale'): ?>
            <p class="ae-meta"><?= $escaper->escapeHtml(__(
                'Not synced yet (last checked %1 UTC).',
                PanelLabels::when($summary->fetchedAt?->format('Y-m-d H:i'))
            )) ?></p>
        <?php elseif ($summary->state === 'preview_running'): ?>
            <div class="ae-inline">
                <?php $running = __('Your first AI read is running. It\'s usually ready in a few minutes.'); ?>
                <p class="ae-meta"><?= $escaper->escapeHtml($running) ?></p>
                <button type="button" class="action-secondary"
                        data-answereng-action="<?= $escaper->escapeHtmlAttr($panel['urls']['refreshSummary']) ?>"
                        data-fields='<?= $escaper->escapeHtmlAttr(json_encode(['store' => $storeId])) ?>'>
                    <?= $escaper->escapeHtml(__('Check again')) ?></button>
            </div>
        <?php elseif ($summary->state === 'preview_complete' && $summary->preview !== null): ?>
            <?php $p = $summary->preview; ?>
            <p class="ae-figure ae-figure--sentence"><?= $escaper->escapeHtml(__(
                'Perplexity recommended your store in %1 of %2 answers',
                (int) $p['answers_recommended'],
                (int) $p['answers']
            )) ?></p>
            <p class="ae-meta"><?= $escaper->escapeHtml(__(
                'Quick preview: %1 questions, one engine. The range is wide (%2–%3%).',
                (int) $p['questions'],
                (int) round(((float) ($p['range'][0] ?? 0)) * 100),
                (int) round(((float) ($p['range'][1] ?? 0)) * 100)
            )) ?></p>
            <ul class="ae-questions">
                <?php foreach ((array) ($p['per_question'] ?? []) as $q): ?>
                    <li>
                        <span class="ae-question"><?= $escaper->escapeHtml((string) $q['text']) ?></span>
                        <span class="ae-answer"><?= (int) $q['answers'] === 0
                            ? $escaper->escapeHtml(__('No readable answers'))
                            : $escaper->escapeHtml(__(
                                'Recommended in %1 of %2 answers',
                                (int) $q['recommended'],
                                (int) $q['answers']
                            )) ?><?php if (!empty($q['competitors_named'])): ?>.
                            <?= $escaper->escapeHtml(__(
                                'Recommended instead: %1',
                                implode(', ', array_map('strval', $q['competitors_named']))
                            )) ?><?php endif; ?></span>
                    </li>
                <?php endforeach; ?>
            </ul>
            <p class="ae-meta"><a href="https://answereng.io/#pricing" target="_blank" rel="noopener">
                <?= $escaper->escapeHtml(__('Free checks 4 engines monthly. Starter checks weekly →')) ?></a></p>
        <?php else: ?>
            <?php $stateText = match ($summary->state) {
                'not_synced' => __('Not synced yet.'),
                'out_of_sync' => __('Out of sync with AnswerEng. Sync now to see results.'),
                'no_run' => __('Connected. Waiting for the first analysis run.'),
                'pending_deletion' => __('This store is scheduled for deletion.'),
                'disabled' => __('Enable this store view and enter an API key to see results.'),
                default => __('Results unavailable: AnswerEng could not be reached.'),
            }; ?>
            <p class="ae-meta"><?= $escaper->escapeHtml($stateText) ?></p>
        <?php endif; ?>
        <?php if ($summary->dashboardUrl !== null): ?>
            <p class="ae-results">
                <a class="ae-results-link" href="<?= $escaper->escapeUrl($summary->dashboardUrl) ?>"
                   target="_blank" rel="noopener"><?= $escaper->escapeHtml(__('Open full results in AnswerEng')) ?>
                    <span aria-hidden="true">→</span></a>
                <?php $signInHint = __('Sign in there with this store view\'s API key.'); ?>
                <span class="ae-results-hint"><?= $escaper->escapeHtml($signInHint) ?></span>
            </p>
        <?php elseif ($panel['testEngine'] !== null): ?>
            <p class="ae-meta ae-results-hint"><?= $escaper->escapeHtml(__(
                'Connected to a test engine at %1. Full results on app.answereng.io are only for stores '
                . 'that sync to AnswerEng.',
                $panel['testEngine']
            )) ?></p>
        <?php endif; ?>
    </section>

    <div class="ae-actions">
        <?php if ($panel['canSync']): ?>
            <button type="button" class="action-secondary"
                    data-answereng-action="<?= $escaper->escapeHtmlAttr($panel['urls']['syncNow']) ?>"
                    data-fields='<?= $escaper->escapeHtmlAttr(json_encode(['store' => $storeId])) ?>'>
                <?= $escaper->escapeHtml(__('Sync now')) ?></button>
        <?php endif; ?>
        <button type="button" class="action-default"
                data-answereng-action="<?= $escaper->escapeHtmlAttr($panel['urls']['testConnection']) ?>"
                data-fields='<?= $escaper->escapeHtmlAttr(json_encode(['store' => $storeId])) ?>'>
            <?= $escaper->escapeHtml(__('Test connection')) ?></button>
        <?php if ($panel['canSync'] && $panel['canClear']): ?>
            <button type="button" class="ae-quiet-action"
                    data-answereng-action="<?= $escaper->escapeHtmlAttr($panel['urls']['clear']) ?>"
                    data-confirm-text="<?= $escaper->escapeHtmlAttr(__(
                        'Remove all products from AnswerEng store "%1" and pause weekly analysis? History and '
                        . 'results are kept, and the store still counts toward your plan. The next sync restores '
                        . 'the catalog.',
                        $panel['storeKey']
                    )) ?>"
                    data-fields='<?= $escaper->escapeHtmlAttr(json_encode(['store' => $storeId])) ?>'>
                <?= $escaper->escapeHtml(__('Clear AnswerEng catalog')) ?></button>
        <?php endif; ?>
    </div>

    <?php if ($panel['log'] !== []): ?>
        <section class="ae-activity" aria-labelledby="ae-activity-<?= (int) $storeId ?>" data-answereng-log>
            <div class="ae-section-head">
                <h3 class="ae-section-title" id="ae-activity-<?= (int) $storeId ?>">
                    <?= $escaper->escapeHtml(__('Recent activity')) ?></h3>
                <?php if (count($panel['log']) > $logShown): ?>
                    <?php $showAll = __('Show all %1', count($panel['log'])); ?>
                    <button type="button" class="ae-quiet-action" data-answereng-toggle-log aria-expanded="false"
                            data-label-more="<?= $escaper->escapeHtmlAttr($showAll) ?>"
                            data-label-less="<?= $escaper->escapeHtmlAttr(__('Show fewer')) ?>">
                        <?= $escaper->escapeHtml($showAll) ?></button>
                <?php endif; ?>
            </div>
            <table class="data-grid ae-grid">
                <thead><tr>
                    <th><?= $escaper->escapeHtml(__('When (UTC)')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Outcome')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Started by')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Detail')) ?></th>
                </tr></thead>
                <tbody>
                <?php foreach ($panel['log'] as $i => $entry): ?>
                    <tr<?= $i >= $logShown ? ' class="ae-log-more" hidden' : '' ?>>
                        <?php $at = PanelLabels::when((string) $entry['created_at']); ?>
                        <td class="ae-nowrap"><?= $escaper->escapeHtml($at) ?></td>
                        <td><?= /* @noEscape */ $pill(PanelLabels::outcome((string) $entry['outcome'])) ?></td>
                        <?php $by = PanelLabels::source(
                            (string) $entry['source'],
                            $entry['admin_user'] !== null ? (string) $entry['admin_user'] : null
                        ); ?>
                        <td><?= $escaper->escapeHtml($by) ?></td>
                        <?php $detail = PanelLabels::detail($entry['detail'] ?? null); ?>
                        <td class="ae-detail"><?= $escaper->escapeHtml($detail) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </section>
    <?php endif; ?>

    <?php if ($panel['canDelete'] && $panel['identities'] !== []): ?>
        <details class="answereng-danger-zone ae-danger">
            <summary><?= $escaper->escapeHtml(__('Danger zone')) ?></summary>
            <?php foreach ($panel['identities'] as $identity): ?>
                <div class="answereng-identity ae-identity" data-answereng-identity
                     data-store-key="<?= $escaper->escapeHtmlAttr($identity['storeKey']) ?>">
                    <?php
                    $meta = [
                        $identity['role'] === 'current' ? __('Current store') : __('Previous store'),
                        match ($identity['status']) {
                            'active' => __('Active'),
                            'pending_deletion' => __('Scheduled for deletion'),
                            'deleted' => __('Deleted'),
                            default => (string) $identity['status'],
                        },
                    ];
                    if ($identity['purgeAfter']) {
                        $meta[] = __('deletes %1 UTC', PanelLabels::when($identity['purgeAfter']));
                    }
                    if ($identity['usedBy'] !== []) {
                        $meta[] = __('also used by %1', implode(', ', $identity['usedBy']));
                    }
                    ?>
                    <p class="ae-identity-head">
                        <code><?= $escaper->escapeHtml($identity['storeKey']) ?></code>
                        <span class="ae-identity-meta"><?= $escaper->escapeHtml(implode(' · ', $meta)) ?></span>
                    </p>
                    <?php $fields = ['store' => $storeId, 'identity_id' => $identity['id']]; ?>
                    <?php if ($identity['status'] === 'active'): ?>
                        <p class="ae-danger-copy"><?= $escaper->escapeHtml(__(
                            'Deleting %1 schedules permanent removal of everything AnswerEng holds for this store: '
                            . 'its catalog, questions, every analysis run and raw AI answer, diagnoses and drafted '
                            . 'fixes, and its dashboard project with its reviewers and invitations. You have 7 days '
                            . 'to cancel. After that it cannot be recovered, and the store\'s plan slot is freed. '
                            . 'Results already shown in the dashboard will disappear.',
                            $identity['storeKey']
                        )) ?></p>
                        <div class="ae-confirm">
                            <label class="ae-field">
                                <span><?= $escaper->escapeHtml(__('Type the store key to confirm')) ?></span>
                                <input type="text" class="admin__control-text" data-confirm-key autocomplete="off"
                                       spellcheck="false"></label>
                            <?php $ack = __('I understand this cannot be undone after 7 days'); ?>
                            <label class="ae-check"><input type="checkbox" data-confirm-ack>
                                <span><?= $escaper->escapeHtml($ack) ?></span></label>
                            <button type="button" class="action-secondary ae-delete" disabled data-confirm-delete
                                    data-answereng-action="<?= $escaper->escapeHtmlAttr($panel['urls']['delete']) ?>"
                                    data-fields='<?= $escaper->escapeHtmlAttr(json_encode($fields)) ?>'>
                                <?= $escaper->escapeHtml(__('Delete store from AnswerEng')) ?></button>
                        </div>
                    <?php elseif ($identity['status'] === 'pending_deletion'): ?>
                        <div class="ae-actions">
                            <button type="button" class="action-secondary"
                                    data-answereng-action="<?= $escaper->escapeHtmlAttr($panel['urls']['cancel']) ?>"
                                    data-fields='<?= $escaper->escapeHtmlAttr(json_encode($fields)) ?>'>
                                <?= $escaper->escapeHtml(__('Cancel deletion')) ?></button>
                        </div>
                    <?php endif; ?>
                    <?php if ($identity['role'] === 'previous'): ?>
                        <div class="ae-actions">
                            <button type="button" class="action-default"
                                    data-answereng-action="<?= $escaper->escapeHtmlAttr($panel['urls']['forget']) ?>"
                                    data-confirm-text="<?= $escaper->escapeHtmlAttr(__(
                                        'Forget this store here? Nothing changes in AnswerEng: the store and its plan '
                                        . 'slot stay.'
                                    )) ?>"
                                    data-fields='<?= $escaper->escapeHtmlAttr(json_encode($fields)) ?>'>
                                <?= $escaper->escapeHtml(__('Forget')) ?></button>
                        </div>
                    <?php endif; ?>
                </div>
            <?php endforeach; ?>
        </details>
    <?php endif; ?>
<?php endif; ?>
</div>
<!-- /answereng-panel -->
