<?php
/**
 * Drafted fixes and the Applied list (WooCommerce render_fixes, render_applied_list).
 * Fix content, reasons and prompt text come from the engine: always escaped.
 *
 * @var \Fullspec\AnswerEng\Block\Adminhtml\Status\Panel $block
 * @var \Magento\Framework\Escaper $escaper
 */
use Fullspec\AnswerEng\Model\Admin\PanelLabels;
use Fullspec\AnswerEng\Model\Admin\SummaryView;

$storeId = $block->getStoreId();
$panel = $block->getPanel();
$results = $panel['results'];
$summary = $results->summary;
$hasResults = $summary->rate !== null && in_array($summary->state, [SummaryView::FRESH, SummaryView::STALE], true);
if (!$hasResults) {
    return;
}
$fixes = $results->fixes;
$applied = $results->applied ?? [];
$canApply = (bool) $panel['canApplyFixes'];
$fixUrl = $escaper->escapeHtmlAttr($panel['urls']['fixApplied']);
$fields = static fn (int $fixId, string $op): string => $escaper->escapeHtmlAttr(
    (string) json_encode(['store' => $storeId, 'fix_id' => $fixId, 'op' => $op])
);
$date = static function (?string $at): string {
    try {
        return $at === null || $at === '' ? '' : (new \DateTimeImmutable($at))->format('j M Y');
    } catch (\Exception) {
        return '';
    }
};
?>
<details class="ae-section ae-fixes" id="answereng-fixes" open>
    <summary><?= $escaper->escapeHtml(__('Drafted fixes')) ?>
        <?php if ($fixes !== null && $fixes !== []): ?>
            <span class="ae-count-chip"><?= $escaper->escapeHtml(__('%1 awaiting review', count($fixes))) ?></span>
        <?php endif; ?>
    </summary>
    <div class="ae-section-body">
    <p class="ae-disclaimer"><?= $escaper->escapeHtml(__(
        'Drafts are suggestions — nothing changes on your store until you apply it yourself.'
    )) ?></p>

    <?php if ($fixes === null): ?>
        <p class="ae-meta"><?= $escaper->escapeHtml(__(
            'Drafted fixes are unavailable right now — they’ll reappear when the engine is reachable.'
        )) ?></p>
    <?php elseif ($fixes === []): ?>
        <p class="ae-meta"><?= $escaper->escapeHtml(__('No drafted fixes await review.')) ?></p>
    <?php else: ?>
        <p class="ae-meta"><?= $escaper->escapeHtml(__(
            'Where your products were missing from answers, AnswerEng diagnosed why and drafted content you can '
            . 'review, copy, and paste into the product editor.'
        )) ?></p>
        <div class="ae-fix-list">
        <?php foreach ($fixes as $fix): ?>
            <?php
            $priority = strtolower($fix->priority);
            $tone = match ($priority) {
                'high' => 'bad',
                'medium' => 'warn',
                default => 'neutral',
            };
            $kind = str_replace('_', ' ', $fix->kind);
            $engineLabel = $fix->engine === '' ? '' : PanelLabels::engine($fix->engine)['label'];
            ?>
            <article class="ae-fix" data-answereng-fix>
                <div class="ae-fix-meta">
                    <?php if ($kind !== ''): ?>
                        <span class="ae-pill ae-pill--neutral"><?= $escaper->escapeHtml($kind) ?></span>
                    <?php endif; ?>
                    <?php if ($priority !== ''): ?>
                        <span class="ae-pill ae-pill--<?= $escaper->escapeHtmlAttr($tone) ?>">
                            <?= $escaper->escapeHtml(__('%1 priority', $priority)) ?></span>
                    <?php endif; ?>
                    <?php if ($engineLabel !== ''): ?>
                        <span class="ae-fix-engine"><?= $escaper->escapeHtml($engineLabel) ?></span>
                    <?php endif; ?>
                    <span class="ae-fix-actions">
                        <button type="button" class="action-default ae-copy"
                                data-answereng-copy="<?= $escaper->escapeHtmlAttr($fix->content) ?>"
                                data-label-copied="<?= $escaper->escapeHtmlAttr(__('Copied')) ?>">
                            <?= $escaper->escapeHtml(__('Copy draft')) ?></button>
                        <?php if ($canApply): ?>
                            <button type="button" class="action-default"
                                    data-answereng-action="<?= /* @noEscape */ $fixUrl ?>"
                                    data-fields="<?= /* @noEscape */ $fields($fix->fixId, 'mark') ?>">
                                <?= $escaper->escapeHtml(__('Mark as applied')) ?></button>
                        <?php endif; ?>
                    </span>
                </div>
                <div class="ae-fix-body">
                    <div class="ae-fix-side">
                        <?php if ($fix->promptText !== ''): ?>
                            <div>
                                <?php $promptLabel = __('Buyer prompt it addresses'); ?>
                                <div class="ae-microlabel"><?= $escaper->escapeHtml($promptLabel) ?></div>
                                <div class="ae-fix-prompt">“<?= $escaper->escapeHtml($fix->promptText) ?>”</div>
                            </div>
                        <?php endif; ?>
                        <?php $reasons = implode('; ', $fix->reasons); ?>
                        <?php if ($reasons !== ''): ?>
                            <div>
                                <div class="ae-microlabel"><?= $escaper->escapeHtml(__('Why you’re missing')) ?></div>
                                <div class="ae-fix-reason"><?= $escaper->escapeHtml($reasons) ?></div>
                            </div>
                        <?php endif; ?>
                    </div>
                    <div class="ae-fix-draft-wrap">
                        <div class="ae-microlabel"><?= $escaper->escapeHtml(__('Draft — review before use')) ?></div>
                        <pre class="ae-fix-draft"><?= $escaper->escapeHtml($fix->content) ?></pre>
                    </div>
                </div>
            </article>
        <?php endforeach; ?>
        </div>
    <?php endif; ?>

    <?php if ($applied !== []): ?>
        <details class="ae-applied">
            <summary><?= $escaper->escapeHtml(__('Applied (%1)', count($applied))) ?></summary>
            <ul class="ae-applied-list">
                <?php foreach ($applied as $fix): ?>
                    <li class="ae-applied-item">
                        <span class="ae-applied-prompt">“<?= $escaper->escapeHtml($fix->promptText) ?>”</span>
                        <?php $when = $date($fix->appliedAt); ?>
                        <?php if ($when !== ''): ?>
                            <?php $markedAt = __('Marked applied %1', $when); ?>
                            <span class="ae-applied-date"><?= $escaper->escapeHtml($markedAt) ?></span>
                        <?php endif; ?>
                        <?php if ($canApply): ?>
                            <button type="button" class="ae-quiet-action"
                                    data-answereng-action="<?= /* @noEscape */ $fixUrl ?>"
                                    data-fields="<?= /* @noEscape */ $fields($fix->fixId, 'unmark') ?>">
                                <?= $escaper->escapeHtml(__('Undo')) ?></button>
                        <?php endif; ?>
                    </li>
                <?php endforeach; ?>
            </ul>
        </details>
    <?php endif; ?>
    </div>
</details>
