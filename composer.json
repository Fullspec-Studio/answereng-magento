{
    "name": "fullspec/module-answereng",
    "description": "AnswerEng for Magento: sync your catalog to AnswerEng and see how AI shopping assistants recommend your store.",
    "type": "magento2-module",
    "license": ["OSL-3.0", "AFL-3.0"],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "magento/framework": "^103.0.6",
        "magento/module-backend": "^102.0.6",
        "magento/module-catalog": "^104.0.6",
        "magento/module-config": "^101.2.6",
        "magento/module-cron": "^100.4.6",
        "magento/module-customer": "^103.0.6",
        "magento/module-store": "^101.1.6"
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.44",
        "magento/magento-coding-standard": "^41",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "repositories": [
        {"type": "composer", "url": "https://mirror.mage-os.org/", "only": ["magento/*"]}
    ],
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {"Fullspec\\AnswerEng\\": ""}
    },
    "autoload-dev": {
        "psr-4": {"Fullspec\\AnswerEng\\Test\\": "Test/"}
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": false,
            "magento/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit",
        "lint": "phpcs",
        "analyse": "phpstan analyse --no-progress"
    }
}
